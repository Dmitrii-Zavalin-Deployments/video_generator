{
  "$id": "video_simulation_engine_output.schema.json",
  "title": "Video Simulation Engine Output",
  "type": "object",
  "additionalProperties": false,

  "properties": {

    "inputs": {
      "type": "object",
      "description": "Source frames, 3D model, and configuration used for visual simulation.",
      "additionalProperties": false,
      "properties": {

        "frame_extractor_output": {
          "type": "string",
          "description": "Path to Video Frame Extractor output JSON."
        },

        "model_file": {
          "type": "string",
          "description": "Path to the 3D model (STEP, STL, OBJ) used for overlay."
        },

        "alignment_reference_file": {
          "type": "string",
          "description": "Optional reference video or frame set for reproducibility comparison."
        },

        "camera_parameters_file": {
          "type": "string",
          "description": "Optional camera calibration parameters (intrinsics/extrinsics)."
        }
      },
      "required": ["frame_extractor_output", "model_file"]
    },

    "config": {
      "type": "object",
      "description": "Configuration for rendering, alignment, annotations, and regulatory evidence generation.",
      "additionalProperties": false,
      "properties": {

        "render_settings": {
          "type": "object",
          "description": "Rendering configuration for 3D overlay.",
          "properties": {
            "lighting_model": { "type": "string" },
            "shadows_enabled": { "type": "boolean" },
            "anti_aliasing": { "type": "boolean" },
            "render_resolution": {
              "type": "object",
              "properties": {
                "width": { "type": "integer" },
                "height": { "type": "integer" }
              }
            }
          }
        },

        "alignment_settings": {
          "type": "object",
          "description": "Configuration for geometry-to-video alignment.",
          "properties": {
            "alignment_method": {
              "type": "string",
              "enum": ["manual", "marker_based", "feature_tracking", "camera_pose"]
            },
            "marker_detection": {
              "type": "boolean",
              "description": "Whether to detect fiducial markers in frames."
            },
            "tolerance_pixels": {
              "type": "number",
              "description": "Maximum allowed alignment error in pixels."
            }
          }
        },

        "annotation_settings": {
          "type": "object",
          "description": "Configuration for measurements, labels, and regulatory annotations.",
          "properties": {
            "show_measurements": { "type": "boolean" },
            "show_axes": { "type": "boolean" },
            "show_alignment_markers": { "type": "boolean" },
            "show_clearance_distances": { "type": "boolean" }
          }
        },

        "output_video_settings": {
          "type": "object",
          "description": "Settings for final rendered video output.",
          "properties": {
            "fps": { "type": "number" },
            "codec": { "type": "string" },
            "bitrate": { "type": "string" }
          }
        }
      }
    },

    "results": {
      "type": "object",
      "description": "Rendered frames, final videos, alignment metrics, feasibility results, and regulatory evidence.",
      "additionalProperties": false,

      "properties": {

        "output_directory": {
          "type": "string",
          "description": "Directory where all rendered frames and videos were saved."
        },

        "overlay_frames": {
          "type": "array",
          "description": "List of frames with 3D model overlay applied.",
          "items": {
            "type": "object",
            "properties": {
              "frame_index": { "type": "integer" },
              "file_path": { "type": "string" },
              "alignment_error_pixels": { "type": "number" }
            },
            "required": ["file_path"]
          }
        },

        "annotation_frames": {
          "type": "array",
          "description": "Frames containing measurements, markers, and regulatory annotations.",
          "items": {
            "type": "object",
            "properties": {
              "frame_index": { "type": "integer" },
              "file_path": { "type": "string" }
            },
            "required": ["file_path"]
          }
        },

        "access_analysis_frames": {
          "type": "array",
          "description": "Frames showing service access, reachability, and maintenance feasibility.",
          "items": {
            "type": "object",
            "properties": {
              "frame_index": { "type": "integer" },
              "file_path": { "type": "string" }
            },
            "required": ["file_path"]
          }
        },

        "final_videos": {
          "type": "array",
          "description": "Rendered videos combining overlays, annotations, and access views.",
          "items": {
            "type": "object",
            "properties": {
              "video_type": {
                "type": "string",
                "enum": ["overlay", "annotated", "access_analysis", "regulatory"]
              },
              "file_path": { "type": "string" }
            },
            "required": ["video_type", "file_path"]
          }
        },

        "alignment_metrics": {
          "type": "object",
          "description": "Quantitative alignment validation results.",
          "properties": {
            "mean_alignment_error_pixels": { "type": "number" },
            "max_alignment_error_pixels": { "type": "number" },
            "alignment_passed": { "type": "boolean" }
          }
        },

        "feasibility_analysis": {
          "type": "object",
          "description": "Assembly and service feasibility indicators.",
          "properties": {
            "assembly_feasible": { "type": "boolean" },
            "minimum_clearance_mm": { "type": "number" },
            "reachability_passed": { "type": "boolean" }
          }
        },

        "regulatory_evidence": {
          "type": "object",
          "description": "Regulatory-grade visual evidence artifacts.",
          "properties": {
            "evidence_package_path": {
              "type": "string",
              "description": "Path to ZIP or folder containing all regulatory evidence."
            },
            "compliance_notes": { "type": "string" }
          }
        }
      },

      "required": [
        "output_directory",
        "overlay_frames",
        "final_videos",
        "alignment_metrics"
      ]
    }
  },

  "required": ["inputs", "config", "results"]
}